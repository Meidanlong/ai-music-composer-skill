# 豆包API（歌词润色主模型）
DOUBAO_API_KEY=sk-your-doubao-key-here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k

# 通义千问API（可选，全局歌词一致性校验）
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 音乐生成API服务商：getge / tianpule / yinchao
MUSIC_API_PROVIDER=getge
MUSIC_API_KEY=sk-your-music-api-key-here

# 音频分析配置
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16

# 任务轮询配置
TASK_POLL_INTERVAL=5
TASK_POLL_TIMEOUT=600
